# ==============================================================================
# Enterprise .gitignore for Full-Stack .NET 10 & React / Docker Application
# ==============================================================================

# --- Environment Variables & Secrets ---
.env
*.env.local
*.env.production

# --- Visual Studio & IDEs ---
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
.idea/
*.sln.iml
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Build Outputs & Caches ---
[Dd]ebug/
[Rr]elease/
x64/
x86/
bld/
bin/
obj/
artifacts/
publish/
*.log
*.tlog

# --- .NET & NuGet ---
project.lock.json
project.fragment.lock.json
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# --- Node.js & Frontend ---
node_modules/
dist/
dist-ssr/
.npm
.eslintcache
.vite/

# --- Operating System Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Docker & Local Overrides ---
docker-compose.override.yml